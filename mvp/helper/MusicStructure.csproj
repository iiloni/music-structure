<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MusicStructure</AssemblyName>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../viewer/dist/**/*">
      <LogicalName>viewer/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <Target Name="RequireViewer" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('../viewer/dist/index.html')" Text="Build mvp/viewer with npm ci and npm run build first." />
  </Target>
</Project>
